  "threshold": 0.0790452710390086,
  "score_type": "mean_squared_reconstruction_error",
  "decision_rule": "flag_for_review_if_reconstruction_error_greater_than_or_equal_to_threshold",
  "input_dtype": "float32",
  "training_method": "trained_on_legitimate_training_transactions_only",
