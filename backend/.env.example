# FinGuard AI - Backend Environment Configuration Example
# Copy to .env and replace placeholders. Never commit actual secret values.

APP_NAME="FinGuard AI API"
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated origins allowed to make API requests)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model and Dataset Artifact Paths (relative to backend directory or absolute)
MODELS_BASE_DIR=../../model files/models
DATASETS_BASE_DIR=../../dataset

# Upload Constraints
MAX_UPLOAD_SIZE_MB=10

# ── Authentication & Identity Provider ──
# Options: "local" (default offline development) or "cognito" (AWS production)
AUTH_PROVIDER=local

# Local JWT Configuration (Used when AUTH_PROVIDER=local)
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ISSUER=finguard-ai
JWT_AUDIENCE=finguard-app

# AWS Amazon Cognito Configuration (Required when AUTH_PROVIDER=cognito)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database & Object Storage ──
# Options: "local" (SQLite file) or "aws" (DynamoDB & S3)
STORAGE_BACKEND=local
LOCAL_DB_PATH=data/finguard.db

# Amazon DynamoDB (Used when STORAGE_BACKEND=aws)
DYNAMODB_TABLE_PREFIX=finguard

# Amazon S3 Private Bucket for Explicitly Saved Reports (Optional)
S3_BUCKET_NAME=finguard-ai-private-reports-bucket
S3_PRESIGNED_EXPIRY_SECONDS=3600
